# Server-side only. NEVER prefix secrets with NEXT_PUBLIC_ — that would ship them to the browser.
# APP_ENV: development | test enable local conveniences. Anything else (or unset) = production (fail closed).
APP_ENV=development
# Experimental single-token auth. Ignored — and unavailable — when APP_ENV is production.
ENABLE_DEV_AUTH=false
DEV_AUTH_TOKEN=
# No provider is implemented yet; leave as "none".
ASSISTANT_PROVIDER=none
# Optional (local dev only): proxy /backend/* to the API from `next dev`.
# API_PROXY_URL=http://127.0.0.1:8000
