# ─── SERVER-SIDE ONLY. Never prefix a secret with NEXT_PUBLIC_ (that would ship it to the browser). ───
# Environment: development | test enable local conveniences; anything else (or unset) = production (fail closed).
APP_ENV=development
ASSISTANT_PROVIDER=none            # set anthropic on API service once safe chat access is enabled
# ── Claude chat (CHAT-AI-1) — OFF unless EVERY item marked REQUIRED is set. See docs/CHAT-AI-1.md. ──
# API service ONLY (REQUIRED): enter the real secret in Railway, never here, never in GitHub, never NEXT_PUBLIC_*.
# ANTHROPIC_API_KEY=
# API service (REQUIRED): model catalogue WITH prices, JSON. Take ids and USD-per-million-token prices from the Anthropic Console / pricing page;
# a model without a price cannot be used, because the hard budget cannot be enforced without it.
# ANTHROPIC_MODELS=[{"id":"<model-id>","label":"<shown in settings>","input_per_mtok":"<usd>","output_per_mtok":"<usd>","max_output":4096}]
# ANTHROPIC_DEFAULT_MODEL=<model-id>   # first catalogue entry when unset; the owner can change it in Settings
# ANTHROPIC_MAX_OUTPUT_TOKENS=1024     # per answer; also the worst case reserved against the budget before each call
# API service (REQUIRED): HARD spend caps in USD, enforced in PostgreSQL before every call. No default: unset => Claude stays off.
# AI_DAILY_BUDGET_USD=2
# AI_MONTHLY_BUDGET_USD=20
# AI_REQUESTS_PER_MINUTE=10            # durable per-account limit
# API service (REQUIRED): accounts allowed to spend (comma-separated UUIDs of rows in `accounts`). Defence in depth behind the BFF.
# AI_ALLOWED_ACCOUNT_IDS=
# WEB service (REQUIRED): independent owner access code (32+ high-entropy characters; `openssl rand -base64 36`) and the acting account id
# (same UUID as in AI_ALLOWED_ACCOUNT_IDS). The browser can never choose the account.
# AI_CHAT_ACCESS_CODE=
# AI_OWNER_ACCOUNT_ID=
# Local tests only (ignored when APP_ENV is production): point the client at a fake Anthropic on localhost.
# ANTHROPIC_BASE_URL=http://127.0.0.1:8792

# Experimental single-token auth for LOCAL development only; ignored (and unavailable) in production.
ENABLE_DEV_AUTH=false
DEV_AUTH_TOKEN=

# ─── BFF <-> API service authentication (shared by BOTH services; >= 32 bytes) ───
#   openssl rand -base64 48
SERVICE_AUTH_SECRET=
SERVICE_AUTH_SECRET_PREVIOUS=      # only during a rotation window
# Web tier only. Base URL of the API; the Next.js SERVER calls <BACKEND_URL>/internal/v1/* with a signed request.
# Local: http://127.0.0.1:8000 · Railway (private network, API has NO public domain): http://safwan-api.railway.internal:8000
# (On Vercel it was injected by a service binding; Railway sets it explicitly.) Unset => the UI shows the server as offline (fail-closed).
BACKEND_URL=http://127.0.0.1:8000
# Local development only (no database): keep nonces in memory. Ignored in production.
SERVICE_NONCE_STORE=memory

# ─── PostgreSQL (two DIFFERENT roles; never reuse one for the other) ───
# Runtime: a LOGIN role that is only a member of the restricted role `safwan_app`. NOT the owner.
# The API deliberately ignores DATABASE_URL (managed-Postgres integrations inject the OWNER there).
APP_DATABASE_URL=
# Migrations: the owner role, used only by `pnpm db:migrate` / CI, never by the running service.
MIGRATION_DATABASE_URL=
# Legacy (not used by the UI any more): proxy /backend/* from `next dev`.
# API_PROXY_URL=http://127.0.0.1:8000

# ── Notifications & reminders (server side only) ─────────────────────────────
# Web Push (VAPID). Generate once:  npx web-push generate-vapid-keys --json   (keep the private key secret; never NEXT_PUBLIC_)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Persistent store for devices/reminders (PostgreSQL, own `notify` schema). Without it production refuses to start the store.
# NOTIFY_DATABASE_URL=postgres://user:pass@host:5432/db
# Dev/staging only: allow the non-persistent in-memory store in production (data lost on restart).
# NOTIFY_ALLOW_MEMORY=0
# Shared secret (>= 24 chars) enabling POST /api/notify/dispatch for an external scheduler (e.g. Railway cron). Unset => endpoint closed.
# NOTIFY_DISPATCH_SECRET=
# In-process dispatch loop (default on). Set 0 when an external scheduler calls /dispatch instead.
# NOTIFY_DISPATCH_LOOP=1
# NOTIFY_TICK_MS=20000
# NOTIFY_MAX_DEVICES=5000
# Extra push-service hosts allowed besides the built-in ones (Apple, FCM, Mozilla, Windows). Comma separated. Leave empty.
# NOTIFY_EXTRA_ENDPOINT_HOSTS=

# ── Chat browser task (CHAT-BROWSER-1; OFF unless both flags below are set — see docs/CHAT-BROWSER.md) ──
# WEB service only: owner access code (>= 32 random chars). Unset => /api/browser/* answers 503 and the card says "not enabled".
# BROWSER_CHAT_ACCESS_CODE=
# API service only: opt-in flag, plus the worker address/token (private network; the token never goes to web or the browser).
# BROWSER_CHAT_ENABLED=1
# BROWSER_SERVICE_URL=http://safwan-browser.railway.internal:8080
# BROWSER_SERVICE_TOKEN=
# Worker service only: allow-listed hosts (default example.com). Do not widen without a security review.
# BROWSER_ALLOWED_HOSTS=example.com

# ── Interactive browser control (CHAT-BROWSER-2; OFF unless this is set — see docs/CHAT-BROWSER-2.md) ──
# `host/prefix/` entries, comma separated, SAME value on safwan-api, safwan-browser and @safwan/web. Click/type happen ONLY inside a scope.
# Empty (default) = interactive control is off everywhere. Never a real business site; the shipped lab is labs/browser-lab/ and must be deployed as its OWN project on its OWN domain (the app refuses a lab on the same site as the app/API).
# BROWSER_INTERACTIVE_SCOPES=your-lab-host.example/browser-lab/
