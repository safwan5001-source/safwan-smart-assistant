# Server-side only. NEVER prefix secrets with NEXT_PUBLIC_ — that would ship them to the browser.
# APP_ENV: development | test enable local conveniences. Anything else (or unset) = production (fail closed).
APP_ENV=development
# Experimental single-token auth. Ignored — and unavailable — when APP_ENV is production.
ENABLE_DEV_AUTH=false
DEV_AUTH_TOKEN=
# No provider is implemented yet; leave as "none".
ASSISTANT_PROVIDER=none
# Server-side only. Base URL of the FastAPI service; the Next.js server probes <BACKEND_URL>/health via /api/health.
# Local: http://127.0.0.1:8000 · Railway: http://safwan-api.railway.internal:8000 (private network, no public API domain).
# Unset => the UI reports the server as offline (fail-closed). Never expose this to the browser (no NEXT_PUBLIC_ prefix).
# BACKEND_URL=http://127.0.0.1:8000
# Legacy (not used by the UI any more): proxy /backend/* from `next dev`.
# API_PROXY_URL=http://127.0.0.1:8000
