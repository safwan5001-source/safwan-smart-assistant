{
  "name": "safwan-smart-assistant",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:web": "pnpm --filter @safwan/web dev",
    "build:web": "pnpm --filter @safwan/web build",
    "typecheck:web": "pnpm --filter @safwan/web typecheck",
    "lint:web": "pnpm --filter @safwan/web lint",
    "test:web": "pnpm --filter @safwan/web test",
    "test:e2e:notify": "pnpm --filter @safwan/web test:e2e:notify",
    "test:api": "cd services/api && uv run --frozen pytest -q",
    "check": "pnpm typecheck:web && pnpm lint:web && pnpm test:web && pnpm build:web && pnpm test:api",
    "e2e:bff": "bash scripts/e2e-bff.sh",
    "db:migrate": "cd services/api && uv run --frozen python -m app.db.migrate"
  }
}
